# Skip package lifecycle (install/postinstall) scripts during `npm install`.
#
# Why: GoDaddy PaaS's build sandbox stopped allowing execution of freshly
# installed node_modules binaries during the install phase (see the
# "airo-sandbox ... skipping path=/app/node_modules mode=rx" warnings and the
# esbuild "spawnSync ... EACCES" failure in the deploy log). esbuild's
# postinstall runs `node install.js`, which validates the platform binary by
# executing it -- that exec is what fails, aborting `npm install`.
#
# This setting skips that validation. It is safe for this dependency set: the
# native packages (esbuild, lmdb, @parcel/watcher, msgpackr-extract, fsevents)
# all locate their platform binary at require-time from their optional-dependency
# packages, which npm still installs -- no lifecycle script is required for them
# to work. esbuild itself runs via its JS shim, which spawns the same binary.
ignore-scripts=true
