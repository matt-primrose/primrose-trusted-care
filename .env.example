# Copy to .env (never commit .env).
# Required by app.js + server/src/services/mail.js.

NODE_ENV=development
PORT=3000

# Mail provider: console | resend | postmark
# `console` logs the email to stdout instead of sending — safe default for dev.
# `resend` requires MAIL_API_KEY (re_xxx...) from https://resend.com/api-keys
# MAIL_FROM must be on a verified Resend domain (see https://resend.com/domains).
MAIL_PROVIDER=console
MAIL_API_KEY=
MAIL_FROM=
MAIL_TO=

# Rate limiting (optional overrides; defaults set in server/src/middleware/rate-limit.js)
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5
