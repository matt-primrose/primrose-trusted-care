# Copy to .env and fill in real values (never commit .env — it's gitignored).
#
# .env is for LOCAL development only (loaded by `npm run dev:server`).
# On GoDaddy PaaS these are set in the dashboard instead — see CLAUDE.md §9.

# ---- Local dev ----
NODE_ENV=development
PORT=3000

# ---- Mail (server/src/services/mail.js) ----
# Provider: console | resend | postmark
#   console — logs the email to stdout instead of sending (safe default for dev)
#   resend  — sends via the Resend REST API (no SDK). Requires MAIL_API_KEY
#             (re_xxx...) from https://resend.com/api-keys. MAIL_FROM must be on
#             a domain verified at https://resend.com/domains.
MAIL_PROVIDER=console
MAIL_API_KEY=
MAIL_FROM=Primrose Trusted Care <info@primrosetrustedcare.com>
MAIL_TO=info@primrosetrustedcare.com

# ---- Rate limiting (optional; defaults in server/src/middleware/rate-limit.js) ----
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5

# ---- Production / GoDaddy PaaS (set in the PaaS dashboard, not used by local dev) ----
# Optional now: client/src/server.ts sets trustProxyHeaders: true on the SSR engine,
# so this only needs setting to override that. Without trusted proxy headers Angular
# stops server-rendering entirely and serves the client-side shell. See CLAUDE.md §9.
NG_TRUST_PROXY_HEADERS=true
#
# Optional: keeps the platform from ever running `ng build` (scripts/build.mjs also
# detects the platform by its /app working directory). The site is built off-platform
# and client/dist is committed; an on-platform build dies either on esbuild EACCES or
# on route extraction binding localhost ("listen EACCES: 127.0.0.1"). See CLAUDE.md §9.
PTC_SKIP_BUILD=1
#
# NOTE: NODE_ENV is a reserved secret on GoDaddy PaaS — you can't set or view it
# (assume "production" at runtime). Allowed SSR hosts are configured in
# client/angular.json (security.allowedHosts), NOT via an env var.
